{
  "name": "siherdefi-server",
  "version": "1.0.0",
  "description": "Enterprise Node.js, Express & MongoDB backend API for Si Her DeFi platform",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "test": "tsx src/test-calendar.ts",
    "add-user": "tsx src/add-user.ts",
    "cms:onboarding": "tsx src/scripts/setup-onboarding-cms.ts",
    "cms:onboarding:check": "tsx src/scripts/check-onboarding-cms.ts",
    "onboarding:reset": "tsx src/scripts/reset-onboarding.ts",
    "cms:modules:check": "tsx src/scripts/check-modules-cms.ts",
    "progress:reset": "tsx src/scripts/reset-progress.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
